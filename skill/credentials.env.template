# GoFi API credentials template.
# Copy to credentials.env and fill in real values:
#   cp credentials.env.template credentials.env
# credentials.env is gitignored and must never be committed.

# Base URL of the GoFi server, no trailing slash.
GOFI_BASE_URL=http://localhost:8080

# Type "upload": required for POST /upload.
GOFI_UPLOAD_KEY=

# Type "download": required for fetching private files, directly or via short link.
GOFI_DOWNLOAD_KEY=

# Type "shorten": required for POST /shorten and short link enable/disable.
GOFI_SHORTEN_KEY=

# Type "api": required for POST /api-keys and key enable/disable.
GOFI_API_KEY=
